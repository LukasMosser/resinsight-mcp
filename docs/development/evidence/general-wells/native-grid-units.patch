+TEST( RifEclipseInputFileToolsTest, GridUnitControlsLoadedCaseUnits )
+{
+    QTemporaryDir directory;
+    ASSERT_TRUE( directory.isValid() );
+    for ( const auto& unit : { QString( "METRES" ), QString( "FEET" ), QString( "CM" ), QString( "INVALID" ) } )
+    {
+        const auto path = directory.filePath( unit + ".GRDECL" );
+        QFile file( path );
+        ASSERT_TRUE( file.open( QFile::WriteOnly ) );
+        QTextStream stream( &file );
+        stream << "SPECGRID\n1 1 1 1 F /\nGRIDUNIT\n'" << unit << "' /\n"
+               << "COORD\n0 0 1000 0 0 1010\n100 0 1000 100 0 1010\n"
+               << "0 100 1000 0 100 1010\n100 100 1000 100 100 1010 /\n"
+               << "ZCORN\n4*1000 4*1010 /\nACTNUM\n1 /\n";
+        stream.flush();
+        file.close();
+        auto data = std::make_unique<RigEclipseCaseData>( nullptr );
+        QString error;
+        const auto loaded = RifEclipseInputFileTools::openGridFile( path, data.get(), false, &error );
+        if ( unit == "INVALID" )
+        {
+            EXPECT_FALSE( loaded );
+            EXPECT_FALSE( error.isEmpty() );
+            continue;
+        }
+        ASSERT_TRUE( loaded ) << error.toStdString();
+        const auto expected = unit == "FEET" ? RiaDefines::EclipseUnitSystem::UNITS_FIELD
+                              : unit == "CM" ? RiaDefines::EclipseUnitSystem::UNITS_LAB
+                                             : RiaDefines::EclipseUnitSystem::UNITS_METRIC;
+        EXPECT_EQ( expected, data->unitsType() );
+        EXPECT_EQ( 1u, data->mainGrid()->cellCount() );
+    }
+}
