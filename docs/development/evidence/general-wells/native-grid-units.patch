+CAF_PDM_OBJECT_METHOD_SOURCE_INIT( RimEclipseCase, RimcEclipseCase_gridUnitSystem, "grid_unit_system" );
+
+RimcEclipseCase_gridUnitSystem::RimcEclipseCase_gridUnitSystem( caf::PdmObjectHandle* self )
+    : caf::PdmObjectMethod( self, PdmObjectMethod::NullPointerType::NULL_IS_INVALID, PdmObjectMethod::ResultType::PERSISTENT_FALSE )
+{
+    CAF_PDM_InitObject( "Grid Unit System" );
+}
+
+std::expected<caf::PdmObjectHandle*, QString> RimcEclipseCase_gridUnitSystem::execute()
+{
+    auto gridCase = self<RimEclipseCase>();
+    if ( !gridCase || !gridCase->eclipseCaseData() )
+    {
+        return std::unexpected( QString( "The case has no loaded grid data." ) );
+    }
+    QString units;
+    switch ( gridCase->eclipseCaseData()->unitsType() )
+    {
+        case RiaDefines::EclipseUnitSystem::UNITS_METRIC: units = "METRIC"; break;
+        case RiaDefines::EclipseUnitSystem::UNITS_FIELD: units = "FIELD"; break;
+        case RiaDefines::EclipseUnitSystem::UNITS_LAB: units = "LAB"; break;
+        default: return std::unexpected( QString( "The loaded grid has an unknown unit system." ) );
+    }
+    auto result = new RimcDataContainerString();
+    result->m_stringValues = { units };
+    return result;
+}
+
+QString RimcEclipseCase_gridUnitSystem::classKeywordReturnedType() const
+{
+    return RimcDataContainerString::classKeywordStatic();
+}
 
