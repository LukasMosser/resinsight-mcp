+RimcGridView_validateViewControls::RimcGridView_validateViewControls( caf::PdmObjectHandle* self )
+    : caf::PdmVoidObjectMethod( self )
+{
+    CAF_PDM_InitObject( "Validate View Controls", "", "", "Validate isolated view controls without changing the view" );
+}
+
+std::expected<caf::PdmObjectHandle*, QString> RimcGridView_validateViewControls::execute()
+{
+    auto result = validateViewControls( self<Rim3dView>() );
+    if ( !result ) return std::unexpected( result.error() );
+    return nullptr;
+}
+
+RimcGridView_setCameraProjection::RimcGridView_setCameraProjection( caf::PdmObjectHandle* self )
+    : caf::PdmVoidObjectMethod( self )
+{
+    CAF_PDM_InitObject( "Set Camera Projection", "", "", "Set camera projection on an open view" );
+    CAF_PDM_InitScriptableField( &m_perspective, "Perspective", true, "Perspective" );
+    CAF_PDM_InitScriptableField( &m_fieldOfViewYDegrees, "FieldOfViewYDegrees", 40.0, "Field of View Y Degrees" );
+    CAF_PDM_InitScriptableField( &m_parallelProjectionHeight, "ParallelProjectionHeight", 1.0, "Parallel Projection Height" );
+}
+
+std::expected<caf::PdmObjectHandle*, QString> RimcGridView_setCameraProjection::execute()
+{
+    auto view = self<Rim3dView>();
+    auto validation = validateViewControls( view );
+    if ( !validation ) return std::unexpected( validation.error() );
+    const double degrees = m_fieldOfViewYDegrees();
+    const double height  = m_parallelProjectionHeight();
+    if ( !std::isfinite( degrees ) || degrees <= 0.0 || degrees >= 180.0 )
+    {
+        return std::unexpected( QString( "Field of view must be finite and between 0 and 180 degrees" ) );
+    }
+    if ( !std::isfinite( height ) || height <= 0.0 )
+    {
+        return std::unexpected( QString( "Parallel projection height must be finite and positive" ) );
+    }
+
+    auto viewer = view->viewer();
+    view->isPerspectiveView = m_perspective();
+    viewer->enableParallelProjection( !m_perspective() );
+    viewer->setCameraFieldOfViewYDegrees( degrees );
+    if ( !m_perspective() )
+    {
+        viewer->setCameraParallelProjectionHeight( height, viewer->pointOfInterest() );
+    }
+    view->updateConnectedEditors();
+    return nullptr;
+}
