+
+void caf::Viewer::setCameraFieldOfViewYDegrees( double degrees )
+{
+    CVF_ASSERT( std::isfinite( degrees ) && degrees > 0.0 && degrees < 180.0 );
+    m_cameraFieldOfViewYDeg = degrees;
+    if ( m_mainCamera->projection() == cvf::Camera::PERSPECTIVE )
+    {
+        m_mainCamera->setProjectionAsPerspective( degrees, m_mainCamera->nearPlane(), m_mainCamera->farPlane() );
+    }
+    else if ( m_navigationPolicy.notNull() )
+    {
+        updateParallelProjectionCameraPosFromPointOfInterestMove( m_navigationPolicy->pointOfInterest() );
+    }
+    update();
+}
+
+double caf::Viewer::cameraParallelProjectionHeight() const
+{
+    return m_mainCamera->frontPlaneFrustumHeight();
+}
+
+void caf::Viewer::setCameraParallelProjectionHeight( double height, const cvf::Vec3d& pointOfInterest )
+{
+    CVF_ASSERT( std::isfinite( height ) && height > 0.0 );
+    CVF_ASSERT( m_mainCamera->projection() == cvf::Camera::ORTHO );
+    m_mainCamera->setProjectionAsOrtho( height, m_mainCamera->nearPlane(), m_mainCamera->farPlane() );
+    updateParallelProjectionCameraPosFromPointOfInterestMove( pointOfInterest );
+    update();
+}
