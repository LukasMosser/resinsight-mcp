+std::expected<void, QString> validateViewControls( Rim3dView* view )
+{
+    if ( !view || !view->viewer() )
+    {
+        return std::unexpected( QString( "View controls require an open view" ) );
+    }
+    if ( view->assosiatedViewLinker() || view->viewController() )
+    {
+        return std::unexpected( QString( "View controls do not support linked or controlled views" ) );
+    }
+    if ( auto gridView = dynamic_cast<RimGridView*>( view ) )
+    {
+        for ( auto filter : gridView->cellFilterCollection()->filters() )
+        {
+            if ( !dynamic_cast<RimCellRangeFilter*>( filter ) )
+            {
+                return std::unexpected( QString( "View controls support only displayed cell range filters" ) );
+            }
+        }
+    }
+    auto eclipseView = dynamic_cast<RimEclipseView*>( view );
+    if ( eclipseView && eclipseView->hasActivePropertyOrDataFilters() )
+    {
+        return std::unexpected( QString( "View controls do not support active property or data filters" ) );
+    }
+    return {};
+}
