 QImage RimMultiPlot::captureSnapshot( int width, int height )
 {
-    QImage image;
+    if ( m_viewer.isNull() ) return QImage();
 
-    if ( m_viewer.isNull() ) return image;
+    if ( m_dockWidget && !m_dockWidget->isCurrentTab() ) m_dockWidget->setAsCurrentTab();
 
-    QSize orgViewSize = m_viewer->size();
+    auto* scheduler = RiaPlotWindowRedrawScheduler::instance();
+    scheduler->performScheduledUpdates();
+    QApplication::processEvents();
 
-    image = RimViewWindow::internalCaptureSnapshot( m_dockWidget, m_viewer->bookWidget(), width, height );
+    const QSize originalSize        = m_viewer->size();
+    const QSize originalMinimumSize = m_viewer->minimumSize();
+    const QSize originalMaximumSize = m_viewer->maximumSize();
+    const bool  originalPreviewMode = m_viewer->pagePreviewModeEnabled();
+    const QSize snapshotSize        = width > 0 && height > 0 ? QSize( width, height ) : originalSize;
 
-    m_viewer->resize( orgViewSize );
-    doUpdateLayout();
+    const auto pages = m_viewer->pages();
+    std::vector<QSize> originalPageSizes;
+    for ( const auto& page : pages ) originalPageSizes.push_back( page->size() );
 
-    return image;
+    const auto restoreViewer = qScopeGuard(
+        [&]()
+        {
+            m_viewer->setPagePreviewModeEnabled( originalPreviewMode );
+            m_viewer->setFixedSize( originalSize );
+            m_viewer->scheduleUpdate();
+            scheduler->performScheduledUpdates();
+            QApplication::processEvents();
+            scheduler->performScheduledUpdates();
+            m_viewer->setMinimumSize( originalMinimumSize );
+            m_viewer->setMaximumSize( originalMaximumSize );
+            m_viewer->resize( originalSize );
+            const auto restoredPages = m_viewer->pages();
+            for ( qsizetype i = 0; i < restoredPages.size() && i < static_cast<qsizetype>( originalPageSizes.size() ); ++i )
+            {
+                restoredPages[i]->resize( originalPageSizes[i] );
+                restoredPages[i]->layout()->activate();
+            }
+        } );
+
+    // Size the pages through their viewer before rendering the complete current page.
+    m_viewer->setPagePreviewModeEnabled( false );
+    m_viewer->setFixedSize( snapshotSize );
+    m_viewer->scheduleUpdate();
+    scheduler->performScheduledUpdates();
+    QApplication::processEvents();
+    scheduler->performScheduledUpdates();
+
+    // A full update creates new pages after the viewer resize event.
+    for ( const auto& page : m_viewer->pages() )
+    {
+        page->resize( snapshotSize );
+        page->layout()->activate();
+    }
+    m_viewer->scheduleReplotOfAllPlots();
+    scheduler->performScheduledUpdates();
+
+    QPixmap pix( snapshotSize );
+    pix.fill( Qt::white );
+    m_viewer->renderTo( &pix );
+    return pix.toImage();
 }
 
