diff --git a/ApplicationLibCode/UnitTests/RigHexIntersectionTools-Test.cpp b/ApplicationLibCode/UnitTests/RigHexIntersectionTools-Test.cpp
index 15e0cd7..fa96e15 100644
--- a/ApplicationLibCode/UnitTests/RigHexIntersectionTools-Test.cpp
+++ b/ApplicationLibCode/UnitTests/RigHexIntersectionTools-Test.cpp
@@ -24,6 +24,73 @@
 
 #include "RigHexIntersectionTools.h"
 
+namespace
+{
+std::array<cvf::Vec3d, 8> unitCellCorners()
+{
+    return { cvf::Vec3d( 0, 0, 0 ), cvf::Vec3d( 1, 0, 0 ), cvf::Vec3d( 1, 1, 0 ), cvf::Vec3d( 0, 1, 0 ),
+             cvf::Vec3d( 0, 0, 1 ), cvf::Vec3d( 1, 0, 1 ), cvf::Vec3d( 1, 1, 1 ), cvf::Vec3d( 0, 1, 1 ) };
+}
+} // namespace
+
+TEST( RigHexIntersectionTools, pointInsideAtFaceCenter )
+{
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.5, 0.5, 0.5 ), unitCellCorners() ) );
+}
+
+TEST( RigHexIntersectionTools, pointInsideAtFaceTriangleEdge )
+{
+    const auto corners = unitCellCorners();
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.25, 0.25, 0.5 ), corners ) );
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.25, 0.75, 0.5 ), corners ) );
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.25, 0.5, 0.5 ), corners ) );
+}
+
+TEST( RigHexIntersectionTools, pointOutsideWithZeroOrTwoBoundaryCrossings )
+{
+    const auto corners = unitCellCorners();
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.5, 0.5, 1.5 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.25, 0.25, 1.5 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.5, 0.5, -0.5 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( -0.5, 0.5, 0.5 ), corners ) );
+}
+
+TEST( RigHexIntersectionTools, pointContainmentWithWarpedFace )
+{
+    auto corners = unitCellCorners();
+    corners[0].z() = -0.2;
+    corners[1].z() = 0.1;
+    corners[2].z() = -0.1;
+    corners[3].z() = 0.2;
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.5, 0.5, 0.5 ), corners ) );
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.25, 0.25, 0.5 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0.5, 0.5, 1.5 ), corners ) );
+}
+
+TEST( RigHexIntersectionTools, pointContainmentAtSharedCellEdge )
+{
+    auto corners = unitCellCorners();
+    for ( auto& corner : corners )
+    {
+        corner = cvf::Vec3d( corner.x() + corner.z() - 1, corner.y(), corner.z() - corner.x() );
+    }
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0, 0.5, 0 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 1, 0.5, 1 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 0, 0.5, 2 ), corners ) );
+}
+
+TEST( RigHexIntersectionTools, pointContainmentAtFieldCoordinates )
+{
+    auto corners = unitCellCorners();
+    for ( auto& corner : corners )
+    {
+        corner = cvf::Vec3d( 9000 + 1000 * corner.x(), 9000 + 1000 * corner.y(), -8425 + 50 * corner.z() );
+    }
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 9500, 9500, -8400 ), corners ) );
+    EXPECT_TRUE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 9250, 9250, -8400 ), corners ) );
+    EXPECT_FALSE( RigHexIntersectionTools::isPointInCell( cvf::Vec3d( 9500, 9500, -8300 ), corners ) );
+}
+
