-    return image;
+    const auto restoreViewer = qScopeGuard(
+        [&]()
+        {
+            m_viewer->setPagePreviewModeEnabled( originalPreviewMode );
+            m_viewer->setFixedSize( originalSize );
+            m_viewer->scheduleUpdate();
+            scheduler->performScheduledUpdates();
+            QApplication::processEvents();
+            scheduler->performScheduledUpdates();
+            m_viewer->setMinimumSize( originalMinimumSize );
+            m_viewer->setMaximumSize( originalMaximumSize );
+            m_viewer->resize( originalSize );
+            const auto restoredPages = m_viewer->pages();
+            for ( qsizetype i = 0; i < restoredPages.size() && i < static_cast<qsizetype>( originalPageSizes.size() ); ++i )
+            {
+                restoredPages[i]->resize( originalPageSizes[i] );
+                restoredPages[i]->layout()->activate();
+            }
+        } );
+
+    // Size the pages through their viewer before rendering the complete current page.
+    m_viewer->setPagePreviewModeEnabled( false );
+    m_viewer->setFixedSize( snapshotSize );
+    m_viewer->scheduleUpdate();
+    scheduler->performScheduledUpdates();
+    QApplication::processEvents();
+    scheduler->performScheduledUpdates();
+
+    // A full update creates new pages after the viewer resize event.
+    for ( const auto& page : m_viewer->pages() )
