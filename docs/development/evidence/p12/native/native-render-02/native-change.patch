+    }
+    m_viewer->scheduleReplotOfAllPlots();
+    scheduler->performScheduledUpdates();
+
+    QPixmap pix( snapshotSize );
+    pix.fill( Qt::white );
+    m_viewer->renderTo( &pix );
+    return pix.toImage();
