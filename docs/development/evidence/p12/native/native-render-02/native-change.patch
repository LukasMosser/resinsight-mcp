+    if ( m_viewer.isNull() ) return QImage();
 
-    if ( m_viewer.isNull() ) return image;
+    if ( m_dockWidget && !m_dockWidget->isCurrentTab() ) m_dockWidget->setAsCurrentTab();
 
-    QSize orgViewSize = m_viewer->size();
+    auto* scheduler = RiaPlotWindowRedrawScheduler::instance();
+    scheduler->performScheduledUpdates();
+    QApplication::processEvents();
 
-    image = RimViewWindow::internalCaptureSnapshot( m_dockWidget, m_viewer->bookWidget(), width, height );
+    const QSize originalSize        = m_viewer->size();
+    const QSize originalMinimumSize = m_viewer->minimumSize();
+    const QSize originalMaximumSize = m_viewer->maximumSize();
+    const bool  originalPreviewMode = m_viewer->pagePreviewModeEnabled();
+    const QSize snapshotSize        = width > 0 && height > 0 ? QSize( width, height ) : originalSize;
 
